# ====== AI Provider 总控 ======
# 可选: volcengine (默认) | minimax | hybrid
# volcengine: 全链路火山引擎（豆包文本 + Seedream图片 + Seedance视频）
# minimax:   全链路 MiniMax（OpenAI文本 + Seedream图片 + Seedance视频）
# hybrid:    文本用火山引擎，图片视频用 MiniMax
AI_PROVIDER=volcengine

# 也可独立控制每个环节（覆盖 AI_PROVIDER）:
# TEXT_PROVIDER=volcengine
# IMAGE_PROVIDER=volcengine
# VIDEO_PROVIDER=volcengine

# ====== 火山引擎（默认方案） ======
# 火山方舟 API Key — 从火山引擎控制台获取
VOLCENGINE_API_KEY=your-volcengine-api-key

# 方舟推理接入点 ID（文本模型，形如 ep-2024xxxxx）
# 创建方式: 火山方舟控制台 → 推理接入点 → 创建 → 选择豆包模型
VOLCENGINE_ARK_ENDPOINT_ID=ep-your-endpoint-id

# 方舟 API 地址（默认北京）
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 图片模型（豆包 Seedream 4.0）
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-0-250828

# 视频模型（豆包 Seedance 1.0 Pro）
VOLCENGINE_VIDEO_MODEL=doubao-seedance-1-0-pro-250528

# ====== MiniMax（备选方案，AI_PROVIDER=minimax 时使用） ======
# MINIMAX_API_KEY=your-minimax-key
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ====== 服务端口 ======
PORT=3001
